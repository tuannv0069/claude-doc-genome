#!/bin/sh
# Enable this hook with: git config core.hooksPath .githooks

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: Node.js is required to run the repository checks." >&2
  exit 1
fi

if ! node scripts/sync-version.mjs check; then
  echo "pre-commit: Synchronize the version fields and stage the corrected files." >&2
  exit 1
fi

if ! node scripts/doc-lint.mjs --quiet; then
  echo "pre-commit: Resolve the documentation findings before committing." >&2
  exit 1
fi
